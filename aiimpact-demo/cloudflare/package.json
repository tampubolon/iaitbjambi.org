{
  "name": "aimpact-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:config && npm run typecheck && npm run test",
    "dev": "wrangler dev",
    "deploy": "npm run check && wrangler deploy",
    "db:apply": "wrangler d1 execute aimpact --file=./schema.sql --remote",
    "check:config": "node check-config.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "confbox": "^0.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "zod": "^4.5.4"
  }
}
